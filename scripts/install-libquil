#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "Usage: $0"
    echo "Installs libquil, which provides quilc and the QVM as a shared library."
    exit 0
fi

err() {
    printf "%s\n" "$@" >&2
    exit 1
}

# TODO(github.com/rigetti/libquil#57): drop the pinned version once the sbcl-librarian
# runtime work is released as a stable version, and install the latest release instead.
# libquil-sys 0.5 links against that runtime, which is so far published only as a
# prerelease; libquil's latest stable release (0.3.2) ships neither it nor its headers.
LIBQUIL_VERSION="${LIBQUIL_VERSION:-0.4.0-rc.0}"

OS="$(uname -s)"
case "${OS}" in
    Linux | Darwin)
        ;;
    # Windows shells report one of these. libquil publishes no Windows build, so there
    # is nothing to install even where the shell would run this script.
    CYGWIN* | MINGW* | MSYS* | Windows_NT)
        err "Windows is not supported: libquil publishes builds for Linux and macOS only."
        ;;
    *)
        err "Unsupported operating system: ${OS}. libquil supports Linux and macOS."
        ;;
esac

# The header, rather than the library, is what decides whether a rebuild is needed:
# sbcl_librarian.h distinguishes a new-enough install, since a 0.3.x install has libquil
# and the include directory but not the runtime headers libquil-sys needs.
if [[ -f /usr/local/include/libquil/sbcl_librarian.h ]]; then
    echo "libquil is already installed. Skipping installation."
    exit 0
fi

# Install libquil's prerequisites, and libclang for bindgen, which generates
# libquil-sys's bindings. BLAS and LAPACK are the ones that matter: magicl loads them at
# runtime under their unversioned names, so a package providing only a versioned name is
# not enough.
if [[ "${OS}" == "Linux" ]]; then
    command -v apt-get >/dev/null 2>&1 ||
        err "This script installs prerequisites with apt, which was not found." \
            "Install libquil's requirements with your package manager, then run its" \
            "installer directly: https://github.com/rigetti/libquil#requirements"

    set -x
    sudo apt-get update
    sudo apt-get install -y unzip curl libclang-dev libblas-dev liblapack-dev
else
    command -v brew >/dev/null 2>&1 ||
        err "This script installs prerequisites with Homebrew, which was not found." \
            "Install libquil's requirements another way, then run its installer" \
            "directly: https://github.com/rigetti/libquil#requirements"

    set -x
    # OpenBLAS provides both BLAS and LAPACK. Homebrew's reference lapack is deliberately
    # not installed: magicl prefers it over every other backend and it computes incorrect
    # eigenvectors on Apple Silicon. libclang ships with the Xcode command line tools, so
    # bindgen needs nothing here.
    brew install openblas libffi
fi

# Hand off to libquil's own installer, taken from the tag being installed rather than
# from a branch: only that version installs the sbcl-librarian runtime and its headers.
INSTALLER="$(mktemp)"
curl -fsSL "https://raw.githubusercontent.com/rigetti/libquil/v${LIBQUIL_VERSION}/install.sh" -o "${INSTALLER}"
bash "${INSTALLER}" "${LIBQUIL_VERSION}"
rm -f "${INSTALLER}"
