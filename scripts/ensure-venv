#!/bin/bash

# Source this file to ensure that the current shell is using a Python virtual environment.
# If not sourced, the script will still create a virtual env.
#
# VENDORED from `qcs-infrastructure` (scripts/cli-tools-base-image/ensure-venv). This repo is
# public and cannot reference that project, so changes made there should be copied here.

# `set -euo pipefail` is not used because this script is intended to be sourced.

if [ -z "$BASH_VERSION" ]; then
    echo "Only Bash is supported, but current shell is not Bash." >&2
    echo "Shell was invoked as: $(ps -o command= -p $$)" >&2
    return 1
fi

if [[ -n "$DEBUG" ]]; then
    echo "Enabling debug mode (DEBUG=$DEBUG)" >&2
    echo "PYTHON_VERSION=${PYTHON_VERSION:-<not set>}" >&2
    set -x
fi

if [[ -n "$PYTHON_VERSION" ]]; then
    PYTHON_VERSION_ARGS="--python ${PYTHON_VERSION}"
else
    echo "PYTHON_VERSION not set; selected version may depend on existing venv or system Python" >&2
    PYTHON_VERSION_ARGS=""
fi

ensure_uv () {
    if ! hash uv 2>/dev/null; then
        echo "couldn't find uv; installing via astral installer" >&2
        curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=$HOME/.local/bin sh
        # If the installation path is already on `PATH`,
        # the installer does not create the `env` script;
        # so check whether `uv` is now on the `PATH` before attempting to source it.
        if ! hash uv 2>/dev/null; then
            . "$HOME/.local/bin/env"
        fi
    else
        echo "'uv' already installed: $(uv --version) at '$(which uv)'" >&2
    fi
}

find_or_choose_venv_path () {
    if [[ -n "$VENV_PATH" ]]; then
        echo "using explicit venv path '$VENV_PATH'" >&2
        echo "$VENV_PATH"
        return
    fi
    local workspace_dir="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [[ -z "$workspace_dir" ]]; then
        echo "not in a git repo; using current directory as workspace" >&2
        echo "$PWD/.venv"
        return
    fi
    local venv_parent="$PWD"
    if [[ "$venv_parent" != "$workspace_dir" && "$parent" != "$workspace_dir/"* ]]; then
        # This is very unexpected: `git rev-parse --show-toplevel` should always print a parent directory.
        echo "current git repo is not a parent of the current directory; using local venv path" >&2
        echo "$PWD/.venv"
        return
    fi
    while [[ "$venv_parent" == "$workspace_dir" || "$parent" == "$workspace_dir/"* ]]; do
        local VENV_PATH="${venv_parent}"/.venv
        if [[ -d "${VENV_PATH}" ]]; then
            echo "using existing venv path '$VENV_PATH'" >&2
            echo $VENV_PATH
            return
        fi
        venv_parent="$(dirname "$parent")"
    done
    # Default to the workspace_dir, so that venvs can be shared unless explicitly forbidden
    echo "using workspace-level venv path" >&2
    echo $workspace_dir/.venv
}

ensure_uv
# VENV_PATH ensures that even if the environment is deactivated, it can be explicitly reused later.
export VENV_PATH="$(find_or_choose_venv_path)"
echo "creating virtual env at '${VENV_PATH}'" >&2
# 'seed' is necessary for pip, setuptools, and wheel, which are needed by maturin.
uv venv --allow-existing --seed ${PYTHON_VERSION_ARGS} "${VENV_PATH}"
if [ -o xtrace ]; then
    # Temporarily disable debug logging, because it's very noisy in the `activate` script.
    set +x
    # ...but do show that we are sourcing that script.
    echo "Sourcing '${VENV_PATH}/bin/activate' (xtrace temporarily disabled)" >&2
    restore_xtrace=true
else
    restore_xtrace=false
fi
. "${VENV_PATH}/bin/activate"
if $restore_xtrace; then
    unset restore_xtrace
    set -x
fi
python --version >&2

# Ensure Rust binaries linked against libpython (e.g. via PyO3) can find the shared library at runtime.
_python_libdir="$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR") or "")' 2>/dev/null)"
if [[ -n "$_python_libdir" ]] && [[ ":${LD_LIBRARY_PATH}:" != *":${_python_libdir}:"* ]]; then
    export LD_LIBRARY_PATH="${_python_libdir}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
unset _python_libdir
